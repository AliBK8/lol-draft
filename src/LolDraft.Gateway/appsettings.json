{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "TrustedProxies": []
  },
  "ReverseProxy": {
    "Routes": {
      "health": {
        "ClusterId": "api",
        "Match": { "Path": "/api/health", "Methods": [ "GET" ] }
      },
      "lobby-create": {
        "ClusterId": "api",
        "RateLimiterPolicy": "lobby-create",
        "Match": { "Path": "/api/lobbies", "Methods": [ "POST" ] }
      },
      "lobby-join": {
        "ClusterId": "api",
        "RateLimiterPolicy": "lobby-join",
        "Match": { "Path": "/api/lobbies/{code}/join", "Methods": [ "POST" ] }
      },
      "lobby-rejoin": {
        "ClusterId": "api",
        "RateLimiterPolicy": "lobby-join",
        "Match": { "Path": "/api/lobbies/{code}/rejoin", "Methods": [ "POST" ] }
      },
      "lobby-get": {
        "ClusterId": "api",
        "AuthorizationPolicy": "guest",
        "Match": { "Path": "/api/lobbies/{code}", "Methods": [ "GET" ] }
      },
      "match-get": {
        "ClusterId": "api",
        "RateLimiterPolicy": "replay",
        "Match": { "Path": "/api/matches/{id}", "Methods": [ "GET" ] }
      },
      "draft-hub": {
        "ClusterId": "api",
        "AuthorizationPolicy": "guest",
        "RateLimiterPolicy": "hub-connect",
        "Match": { "Path": "/hubs/draft/{**rest}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://api:8080" }
        }
      }
    }
  }
}
