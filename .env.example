# docker compose ayarları. Kopyala: cp .env.example .env  (.env repoya girmez)
# Sırlar rastgele üretilmeli, ör: openssl rand -base64 48
# Gateway ve API aynı değerleri kullanır (compose ikisine de verir).

# Gateway → API paylaşılan sırrı, en az 32 karakter
GATEWAY_SECRET=
# Misafir JWT imza anahtarı, en az 32 bayt
JWT_SIGNING_KEY=

# Caddy'nin sunduğu alan adı. localhost: iç CA ile sertifika. Gerçek alan adı: Let's Encrypt.
SITE_ADDRESS=localhost
# Makinede 80/443 doluysa değiştir (ör. 8080/8443)
HTTP_PORT=80
HTTPS_PORT=443

# Replay saklama (gün, 0 = silme), yedek aralığı (saat) ve saklanan yedek sayısı
MATCH_RETENTION_DAYS=180
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28
